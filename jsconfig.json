{
    "compilerOptions": {
        "checkJs": true,
        "allowJs": true,
        "target": "ES2020",
        "module": "ES2020",
        "moduleResolution": "bundler",
        "noImplicitAny": false,
        "strictNullChecks": true,
        "strictFunctionTypes": true,
        "noEmit": true,
        "skipLibCheck": true
    },
    "include": ["scripts/**/*.js"]
}
